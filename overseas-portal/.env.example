# microCMS サービスドメイン（https://<ここ>.microcms.io）
MICROCMS_SERVICE_DOMAIN=eitoss
# microCMS APIキー（GET権限。シード投入時は POST/PUT 権限も必要）
MICROCMS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook からのオンデマンド再検証用シークレット（任意）
REVALIDATE_SECRET=change-me
# 公開URL（OGP等）
NEXT_PUBLIC_SITE_URL=https://example.com
SITE_PUBLIC=0  # 1にすると検索エンジンに公開
